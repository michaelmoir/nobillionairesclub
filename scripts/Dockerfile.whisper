# Build once: docker build -f scripts/Dockerfile.whisper -t nbc-whisper .
FROM python:3.11-slim

# Avoid debconf "Dialog/Readline/Teletype" warnings during non-interactive apt installs
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir openai-whisper

WORKDIR /data

ENTRYPOINT ["python", "-m", "whisper"]
